# Every pull request needs an approval from a committer. An approval from an app
# with write access to the repo would count toward the one `main` requires, but
# an app isn't a code owner, so a committer still has to approve.
* @sst-community/committers

# The files below override that: a pull request that changes one needs a review
# from its owner. They decide what gets built, released to npm, and run on a
# user's machine at install.

# Workflows, their scripts, the automatic review's rules, and this file.
/.github/ @the-human-mustachio

# The release build and the container image it pushes.
/.goreleaser.yml @the-human-mustachio
/platform/scripts/build @the-human-mustachio

# The npm package: what's published, and what runs when it's installed.
/sdk/js/package.json @the-human-mustachio
/sdk/js/scripts/ @the-human-mustachio
/sdk/js/bin/ @the-human-mustachio

# The install script, and where the CLI installs and upgrades from.
/install @the-human-mustachio
/pkg/global/distribution.go @the-human-mustachio
