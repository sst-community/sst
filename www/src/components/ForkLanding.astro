---
// Home page for the sst-community docs site. The right-hand column is how to
// switch a project from SST. It names no versions or fixes, so it doesn't need
// editing when a release is made; what a release changes is in its notes.
import config from "../../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/sst-community/sst";
const command = "npm install sst@npm:@sst-community/sst";
---

<section class="fl" aria-labelledby="fl-title">
  <div class="fl-intro">
    <p class="fl-eyebrow">Community fork of SST <span aria-hidden="true">·</span> not affiliated with SST or Anomaly</p>
    <h1 id="fl-title" class="fl-title">SST, <em>plus the fixes.</em></h1>
    <p class="fl-lede">
      sst-community follows SST's releases and ships fixes that haven't landed upstream yet.
      Same config, same docs. Only your <code>sst</code> dependency changes.
    </p>

    <div class="fl-install">
      <code class="fl-command">npm install <span class="fl-nowrap">sst@npm:@sst-community/sst</span></code>
      <button type="button" class="fl-copy" data-copy={command}>Copy</button>
    </div>
    <p class="fl-requires">
      Needs <strong>Node.js 22 or later</strong>, wherever you run <code>sst</code>, CI included.
    </p>
    <div class="fl-actions">
      <a class="fl-button" href={`${base}/docs/`}>Read the docs</a>
      <a class="fl-link" href={`${repo}/releases`}>Releases</a>
      <a class="fl-link" href={repo}>GitHub</a>
      <a class="fl-link" href={config.forkDiscord}>Discord</a>
    </div>
  </div>

  <div class="fl-switch">
    <h2 id="fl-switch-title" class="fl-caption">Switch a project from SST</h2>
    <ol class="fl-steps" aria-labelledby="fl-switch-title">
      <li class="fl-step">
        <p class="fl-step-title">Use Node.js 22 or later</p>
        <p class="fl-step-body">
          <code>node --version</code> should show <code>v22</code> or later, wherever you run
          <code>sst</code>, CI included. On an older Node.js the CLI warns, and some features fail.
        </p>
      </li>
      <li class="fl-step">
        <p class="fl-step-title">Run the install in your project</p>
        <p class="fl-step-body">
          One line of <code>package.json</code> changes. Your imports and your
          <code>sst.config.ts</code> stay as they are.
        </p>
        <figure class="fl-diff">
          <figcaption>package.json</figcaption>
          <pre><span class="fl-del"><span class="fl-sign" aria-hidden="true">-</span><span>"sst": <span class="fl-val">"<i>&lt;version&gt;</i>"</span></span></span>
<span class="fl-add"><span class="fl-sign" aria-hidden="true">+</span><span>"sst": <span class="fl-val">"<b>npm:@sst-community/sst@</b><i>&lt;version&gt;</i>"</span></span></span></pre>
        </figure>
        <p class="fl-step-body">
          With pnpm, bun or yarn, use <code>add</code> in place of <code>install</code>.
        </p>
        <p class="fl-step-body">
          Using the Astro or SvelteKit adapter? Switch its line the same way, to
          <code>npm:@sst-community/astro-sst</code> or
          <code>npm:@sst-community/svelte-kit-sst</code>.
        </p>
      </li>
      <li class="fl-step">
        <p class="fl-step-title">Check which CLI runs</p>
        <p class="fl-step-body">
          <code>npx sst version</code> names <code>sst-community</code> and the SST
          release it's built on.
        </p>
      </li>
      <li class="fl-step">
        <p class="fl-step-title">Deploy as before</p>
        <p class="fl-step-body">
          The fork reads the same config and the same state, so <code>sst dev</code> and
          <code>sst deploy</code> carry on where you left off. <code>sst upgrade</code>
          keeps you on the fork.
        </p>
      </li>
    </ol>
    <p class="fl-back">
      To go back to SST, run <code>npm install sst@latest</code>.
    </p>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".fl-copy")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  /* The landing page is wider than a docs page. */
  :global(:root[data-has-hero]) {
    --sl-content-width: 74rem;
  }

  .fl {
    --fl-upstream: var(--sl-color-accent);
    --fl-fork: hsl(42, 78%, 60%);
    --fl-ink: var(--sl-color-white);
    --fl-text: var(--sl-color-gray-2);
    --fl-muted: var(--sl-color-gray-3);
    --fl-rule: var(--sl-color-gray-5);
    --fl-panel: var(--sl-color-gray-6);

    --fl-gutter: 2.75rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vh, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(2.5rem, 8vh, 6rem);
    text-align: start;
  }
  :global(:root[data-theme="light"]) .fl {
    --fl-fork: hsl(35, 88%, 33%);
  }

  @media (min-width: 60rem) {
    .fl {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
      align-content: center;
      min-height: calc(100svh - var(--sl-nav-height) - 4rem);
    }
  }

  .fl p {
    margin: 0;
  }
  .fl code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* Intro */
  .fl-eyebrow {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--fl-muted);
    letter-spacing: 0.01em;
  }
  .fl-title {
    margin: 1rem 0 0;
    font-family: var(--sl-font);
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--fl-ink);
  }
  .fl-title em {
    display: block;
    font-style: normal;
    color: var(--fl-fork);
  }
  .fl-lede {
    margin-top: 1.5rem !important;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--fl-text);
  }
  .fl-lede code {
    color: var(--fl-ink);
  }

  /* Install */
  .fl-install {
    display: flex;
    align-items: stretch;
    margin-top: 2rem;
    max-width: 34rem;
    border: 1px solid var(--fl-rule);
    border-radius: 0.5rem;
    background: var(--fl-panel);
    overflow: hidden;
  }
  .fl-command {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.875rem !important;
    color: var(--fl-ink);
    background: none;
  }
  .fl-command::before {
    content: "$ ";
    color: var(--fl-muted);
  }
  /* On phones the command wraps after "npm install" rather than hiding its end. */
  @media (max-width: 30rem) {
    .fl-command {
      white-space: normal;
    }
  }
  .fl-nowrap {
    white-space: nowrap;
  }
  @media (max-width: 22rem) {
    .fl-command {
      padding-inline: 0.75rem;
      font-size: 0.78rem !important;
    }
    .fl-copy {
      padding: 0 0.7rem;
    }
  }
  .fl-copy {
    flex: none;
    padding: 0 1rem;
    border: 0;
    border-left: 1px solid var(--fl-rule);
    background: none;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--fl-muted);
    cursor: pointer;
  }
  .fl-copy:hover {
    color: var(--fl-ink);
  }
  .fl-requires {
    position: relative;
    margin-top: 0.85rem !important;
    max-width: 34rem;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--fl-text);
  }
  .fl-requires::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--fl-fork);
  }
  .fl-requires strong {
    color: var(--fl-ink);
    font-weight: 600;
  }
  .fl-requires code {
    color: var(--fl-ink);
  }

  .fl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
  .fl-button {
    padding: 0.7rem 1.25rem;
    border-radius: 999rem;
    background: var(--fl-upstream);
    color: var(--sl-color-black);
    font-weight: 500;
    text-decoration: none;
  }
  .fl-button:hover {
    background: var(--sl-color-accent-high);
  }
  .fl-link {
    color: var(--fl-ink);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--fl-rule);
  }
  .fl-link:hover {
    border-bottom-color: var(--fl-ink);
  }
  .fl a:focus-visible,
  .fl-copy:focus-visible {
    outline: 2px solid var(--fl-fork);
    outline-offset: 3px;
  }

  /* Switch steps */
  .fl-caption {
    margin: 0 0 1.25rem !important;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--fl-muted);
  }
  .fl-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: fl-step;
  }
  .fl-step {
    position: relative;
    margin: 0 !important;
    padding: 0 0 1.6rem var(--fl-gutter);
    counter-increment: fl-step;
  }
  .fl-step:last-child {
    padding-bottom: 0;
  }
  .fl-step::before {
    content: counter(fl-step);
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    color: var(--fl-fork);
  }
  /* A rule from each number down to the next. */
  .fl-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.9rem;
    bottom: 0.4rem;
    left: calc(0.75rem - 0.5px);
    width: 1px;
    background: var(--fl-rule);
  }
  .fl-step-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--fl-ink);
  }
  .fl-step-body {
    margin-top: 0.3rem !important;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--fl-muted);
  }
  .fl-step-body code,
  .fl-back code {
    color: var(--fl-text);
  }

  /* The one line that changes. */
  .fl-diff {
    margin: 0.9rem 0 0.8rem;
    border: 1px solid var(--fl-rule);
    border-radius: 0.5rem;
    background: var(--fl-panel);
    overflow: hidden;
  }
  .fl-diff figcaption {
    padding: 0.45rem 0.9rem;
    border-bottom: 1px solid var(--fl-rule);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--fl-muted);
  }
  .fl-diff pre {
    margin: 0;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    white-space: normal;
  }
  .fl-del,
  .fl-add {
    display: flex;
    gap: 0.75rem;
    padding: 0.05rem 0.9rem;
    overflow-wrap: anywhere;
  }
  .fl-sign {
    flex: none;
  }
  /* On a narrow screen the value drops to its own line before it breaks. */
  .fl-val {
    display: inline-block;
    max-width: 100%;
  }
  .fl-del {
    color: var(--fl-muted);
  }
  .fl-add {
    color: var(--fl-ink);
    background: color-mix(in srgb, var(--fl-fork) 9%, transparent);
  }
  .fl-add .fl-sign,
  .fl-add b {
    font-weight: inherit;
    color: var(--fl-fork);
  }
  .fl-diff i {
    font-style: normal;
    color: var(--fl-muted);
  }
  /* Phones: tighter, so the new value fits on one line under its key. */
  @media (max-width: 30rem) {
    .fl {
      --fl-gutter: 2rem;
    }
    .fl-diff pre {
      font-size: 0.75rem;
    }
    .fl-diff figcaption,
    .fl-del,
    .fl-add {
      padding-inline: 0.7rem;
    }
    .fl-del,
    .fl-add {
      gap: 0.6rem;
    }
  }
  @media (max-width: 22rem) {
    .fl-val {
      display: inline;
    }
  }

  .fl-back {
    margin-top: 1.6rem !important;
    padding: 1rem 0 0 var(--fl-gutter);
    border-top: 1px solid var(--fl-rule);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--fl-muted);
  }
</style>
