---
// Home page for the sst-community docs site. The branch diagram shows the
// fork's line leaving SST's release line, one commit per change the fork makes.
import config from "../../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/sst-community/sst";
const command = "npm install sst@npm:@sst-community/sst";

const changes = [
  {
    title: "sst dev keeps its connection",
    body: "Before forwarding an invocation, the dev bridge checks its subscription is live and reconnects if it isn't. Responses aren't lost after a function sits idle or on cold starts.",
  },
  {
    title: "Stages stop breaking each other",
    body: "Removing or redeploying one stage no longer deletes the dev bridge zip that every other stage in the account shares.",
  },
  {
    title: "Log lines say which function",
    body: "The sst dev UI tags each function's output with its name and gives concurrent invocations their own color.",
  },
  {
    title: "No telemetry",
    body: "Fork builds don't send usage data anywhere.",
  },
];
---

<section class="fl" aria-labelledby="fl-title">
  <div class="fl-intro">
    <p class="fl-eyebrow">Community fork of SST <span aria-hidden="true">·</span> not affiliated with SST or Anomaly</p>
    <h1 id="fl-title" class="fl-title">SST, <em>plus the fixes.</em></h1>
    <p class="fl-lede">
      sst-community follows SST's releases and ships fixes that haven't landed upstream yet.
      Same config, same docs. Only your <code>sst</code> dependency changes.
    </p>

    <div class="fl-install">
      <code class="fl-command">npm install <span class="fl-nowrap">sst@npm:@sst-community/sst</span></code>
      <button type="button" class="fl-copy" data-copy={command}>Copy</button>
    </div>
    <p class="fl-note">
      Switching a project? Set <code>"sst": "npm:@sst-community/sst@&lt;version&gt;"</code> and reinstall.
    </p>

    <div class="fl-actions">
      <a class="fl-button" href={`${base}/docs/`}>Read the docs</a>
      <a class="fl-link" href={`${repo}/releases`}>Releases</a>
      <a class="fl-link" href={repo}>GitHub</a>
      <a class="fl-link" href={config.forkDiscord}>Discord</a>
    </div>
  </div>

  <figure class="fl-graph">
    <figcaption class="fl-caption">What the fork adds on top of SST</figcaption>
    <ol class="fl-log">
      <li class="fl-row fl-row-tag">
        <span class="fl-lane" aria-hidden="true"></span>
        <span class="fl-dot" aria-hidden="true"></span>
        <p class="fl-row-title">sst-community release</p>
        <p class="fl-row-body">Published to npm as <code>@sst-community/sst</code>.</p>
      </li>
      {changes.map((change) => (
        <li class="fl-row">
          <span class="fl-lane" aria-hidden="true"></span>
          <span class="fl-dot" aria-hidden="true"></span>
          <p class="fl-row-title">{change.title}</p>
          <p class="fl-row-body">{change.body}</p>
        </li>
      ))}
      <li class="fl-row fl-row-upstream">
        <span class="fl-branch" aria-hidden="true"></span>
        <span class="fl-dot" aria-hidden="true"></span>
        <p class="fl-row-title">SST release</p>
        <p class="fl-row-body">Each fork release starts from one and keeps its version line: sst-community 4.17.x is built on SST 4.17.</p>
      </li>
    </ol>
  </figure>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".fl-copy")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  /* The landing page is wider than a docs page. */
  :global(:root[data-has-hero]) {
    --sl-content-width: 74rem;
  }

  .fl {
    --fl-upstream: var(--sl-color-accent);
    --fl-fork: hsl(42, 78%, 60%);
    --fl-ink: var(--sl-color-white);
    --fl-text: var(--sl-color-gray-2);
    --fl-muted: var(--sl-color-gray-3);
    --fl-rule: var(--sl-color-gray-5);
    --fl-panel: var(--sl-color-gray-6);

    --fl-lane-up: 0.5rem;
    --fl-lane-fork: 1.75rem;
    --fl-dot-y: 0.72rem;
    --fl-dot: 0.625rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vh, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(2.5rem, 8vh, 6rem);
    text-align: start;
  }
  :global(:root[data-theme="light"]) .fl {
    --fl-fork: hsl(35, 88%, 33%);
  }

  @media (min-width: 60rem) {
    .fl {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
      align-content: center;
      min-height: calc(100svh - var(--sl-nav-height) - 4rem);
    }
  }

  .fl p {
    margin: 0;
  }
  .fl code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* Intro */
  .fl-eyebrow {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--fl-muted);
    letter-spacing: 0.01em;
  }
  .fl-title {
    margin: 1rem 0 0;
    font-family: var(--sl-font);
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--fl-ink);
  }
  .fl-title em {
    display: block;
    font-style: normal;
    color: var(--fl-fork);
  }
  .fl-lede {
    margin-top: 1.5rem !important;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--fl-text);
  }
  .fl-lede code {
    color: var(--fl-ink);
  }

  /* Install */
  .fl-install {
    display: flex;
    align-items: stretch;
    margin-top: 2rem;
    max-width: 34rem;
    border: 1px solid var(--fl-rule);
    border-radius: 0.5rem;
    background: var(--fl-panel);
    overflow: hidden;
  }
  .fl-command {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.875rem !important;
    color: var(--fl-ink);
    background: none;
  }
  .fl-command::before {
    content: "$ ";
    color: var(--fl-muted);
  }
  /* On phones the command wraps after "npm install" rather than hiding its end. */
  @media (max-width: 30rem) {
    .fl-command {
      white-space: normal;
    }
  }
  .fl-nowrap {
    white-space: nowrap;
  }
  @media (max-width: 22rem) {
    .fl-command {
      padding-inline: 0.75rem;
      font-size: 0.78rem !important;
    }
    .fl-copy {
      padding: 0 0.7rem;
    }
  }
  .fl-copy {
    flex: none;
    padding: 0 1rem;
    border: 0;
    border-left: 1px solid var(--fl-rule);
    background: none;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--fl-muted);
    cursor: pointer;
  }
  .fl-copy:hover {
    color: var(--fl-ink);
  }
  .fl-note {
    margin-top: 0.75rem !important;
    max-width: 34rem;
    font-size: 0.875rem;
    color: var(--fl-muted);
  }
  .fl-note code {
    overflow-wrap: anywhere;
  }

  .fl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
  .fl-button {
    padding: 0.7rem 1.25rem;
    border-radius: 999rem;
    background: var(--fl-upstream);
    color: var(--sl-color-black);
    font-weight: 500;
    text-decoration: none;
  }
  .fl-button:hover {
    background: var(--sl-color-accent-high);
  }
  .fl-link {
    color: var(--fl-ink);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--fl-rule);
  }
  .fl-link:hover {
    border-bottom-color: var(--fl-ink);
  }
  .fl a:focus-visible,
  .fl-copy:focus-visible {
    outline: 2px solid var(--fl-fork);
    outline-offset: 3px;
  }

  /* Branch diagram */
  .fl-graph {
    margin: 0;
  }
  .fl-caption {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--fl-muted);
    margin-bottom: 1.25rem;
  }
  .fl-log {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* SST's line runs the full height, dashed where it continues without the fork. */
  .fl-log::before {
    content: "";
    position: absolute;
    top: var(--fl-dot-y);
    bottom: 0;
    left: calc(var(--fl-lane-up) - 1px);
    border-left: 2px dashed color-mix(in srgb, var(--fl-upstream) 45%, transparent);
  }
  .fl-row {
    position: relative;
    margin: 0 !important;
    padding: 0 0 1.35rem 3rem;
  }
  .fl-row-title {
    font-family: var(--sl-font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--fl-ink);
  }
  .fl-row-body {
    margin-top: 0.2rem !important;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--fl-muted);
  }
  .fl-row-body code {
    color: var(--fl-text);
  }

  .fl-dot {
    position: absolute;
    top: calc(var(--fl-dot-y) - var(--fl-dot) / 2);
    left: calc(var(--fl-lane-fork) - var(--fl-dot) / 2);
    width: var(--fl-dot);
    height: var(--fl-dot);
    border-radius: 50%;
    background: var(--fl-fork);
    box-shadow: 0 0 0 3px var(--sl-color-black);
  }
  .fl-row-tag .fl-dot {
    border-radius: 2px;
    transform: rotate(45deg) scale(1.15);
  }
  .fl-row-tag .fl-row-title {
    color: var(--fl-fork);
  }

  /* The fork's line: from each commit down to the next. */
  .fl-lane {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--fl-lane-fork) - 1px);
    width: 2px;
    background: var(--fl-fork);
    transform-origin: bottom;
  }
  .fl-row-tag .fl-lane {
    top: var(--fl-dot-y);
  }

  /* Where the fork leaves SST's line. */
  .fl-row-upstream {
    padding-bottom: 0;
  }
  .fl-row-upstream .fl-dot {
    left: calc(var(--fl-lane-up) - var(--fl-dot) / 2);
    background: var(--fl-upstream);
  }
  .fl-branch {
    position: absolute;
    top: 0;
    left: var(--fl-lane-up);
    width: calc(var(--fl-lane-fork) - var(--fl-lane-up) + 1px);
    height: var(--fl-dot-y);
    border-right: 2px solid var(--fl-fork);
    border-bottom: 2px solid var(--fl-fork);
    border-bottom-right-radius: 0.75rem;
    transform-origin: left bottom;
  }
  .fl-row-upstream .fl-row-title {
    color: var(--fl-upstream);
  }

  /* Draw the fork's line up from where it leaves SST, once, on load. */
  @media (prefers-reduced-motion: no-preference) {
    .fl-branch,
    .fl-lane,
    .fl-dot {
      animation: fl-grow 420ms cubic-bezier(0.3, 0.7, 0.2, 1) both;
    }
    .fl-lane {
      animation-name: fl-draw;
    }
    .fl-row:nth-last-child(1) > * { animation-delay: 0ms; }
    .fl-row:nth-last-child(2) > * { animation-delay: 140ms; }
    .fl-row:nth-last-child(3) > * { animation-delay: 280ms; }
    .fl-row:nth-last-child(4) > * { animation-delay: 420ms; }
    .fl-row:nth-last-child(5) > * { animation-delay: 560ms; }
    .fl-row:nth-last-child(6) > * { animation-delay: 700ms; }
  }
  @keyframes fl-draw {
    from { transform: scaleY(0); }
  }
  @keyframes fl-grow {
    from { opacity: 0; }
  }
</style>
