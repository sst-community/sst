#!/usr/bin/env bash
# The platform's types, which apps and component packages read in place of
# its source: compiled from src, plus the declaration files written by hand.
# scripts/build runs it, and so does scripts/api.ts, which reports the API
# they make.

cd "$( dirname "${BASH_SOURCE[0]}" )/.." || exit 1

rm -rf ./dist/types
npx tsc -p tsconfig.types.json || exit 1
(cd src && find . -name "*.d.ts" | while read -r file; do
  mkdir -p "../dist/types/$(dirname "$file")"
  cp "$file" "../dist/types/$file"
done)
# The `sst` global's module is only re-exports, so it's its own declaration
# (see tsconfig.types.json)
cp ./src/components/index.ts ./dist/types/components/index.d.ts
# Their imports get their `.js`, and are checked under NodeNext
node ./scripts/types.mjs || exit 1
