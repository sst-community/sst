#!/usr/bin/env bash

ORIGINAL_DIR=$(pwd)
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
echo "moving to $SCRIPT_DIR"
cd $SCRIPT_DIR

bun build ./functions/cf-static-site-router-worker/index.ts --target=node --outdir ./dist/cf-static-site-router-worker/
bun build ./functions/cf-ssr-site-router-worker/index.ts --target=node --outdir ./dist/cf-ssr-site-router-worker/
bun build ./functions/nodejs-runtime/index.ts --target=node --outdir ./dist/nodejs-runtime/
bun build ./functions/nodejs-runtime/loop.ts --target=node --outdir ./dist/nodejs-runtime/
GOARCH=amd64 GOOS=linux go build -trimpath -buildvcs=false -mod=readonly -ldflags="-buildid=" -o ./dist/bridge/bootstrap ./functions/bridge
node ./scripts/build.mjs

# The platform's types, which apps and component packages read in place of
# its source: compiled from src, plus the declaration files written by hand
rm -rf ./dist/types
npx tsc -p tsconfig.types.json || exit 1
(cd src && find . -name "*.d.ts" | while read -r file; do
  mkdir -p "../dist/types/$(dirname "$file")"
  cp "$file" "../dist/types/$file"
done)
# The `sst` global's module is only re-exports, so it's its own declaration
# (see tsconfig.types.json)
cp ./src/components/index.ts ./dist/types/components/index.d.ts
# Their imports get their `.js`, and are checked under NodeNext
node ./scripts/types.mjs || exit 1

mkdir -p ./dist/nodejs-bridge
cp ./functions/nodejs-bridge/index.mjs ./dist/nodejs-bridge/index.mjs
cp ./dist/bridge/bootstrap ./dist/nodejs-bridge/bootstrap

mkdir -p ./dist/python-runtime/
cp ./functions/python-runtime/index.py ./dist/python-runtime/index.py

mkdir -p ./dist/dockerfiles/
cp ./functions/docker/python.Dockerfile ./dist/dockerfiles/python.Dockerfile

cd ./support/bridge-task
mkdir -p build/amd64 build/arm64
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -buildvcs=false -mod=readonly -ldflags="-buildid=" -o build/amd64/main .
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -buildvcs=false -mod=readonly -ldflags="-buildid=" -o build/arm64/main .

timestamp=$(date +%Y%m%d%H%M%S)
docker buildx inspect >/dev/null 2>&1 || docker buildx create --name multi --driver docker-container --use

CACHE_ARGS=""
if [ -n "$GITHUB_ACTIONS" ]; then
  CACHE_ARGS="--cache-from type=gha,scope=bridge-task --cache-to type=gha,mode=max,scope=bridge-task"
fi

docker buildx build \
  --platform linux/amd64,linux/arm64 \
  -f Dockerfile \
  $CACHE_ARGS \
  -t ghcr.io/sst-community/sst/bridge-task:$timestamp \
  -t ghcr.io/sst-community/sst/bridge-task:latest \
  $([ "$DOCKER_PUSH" = "true" ] && echo "--push") \
  build

cd $ORIGINAL_DIR
