{
  // The platform's types for apps and component packages, built into
  // dist/types by scripts/build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist/types",
    "rootDir": "src",
    // In this repo some providers have their own copy of @pulumi/pulumi. An
    // app has one, so the types are written against that one.
    "paths": {
      "@pulumi/pulumi": ["../node_modules/@pulumi/pulumi"],
      "@pulumi/pulumi/*": ["../node_modules/@pulumi/pulumi/*"]
    }
  },
  "include": ["src"],
  // Without the `sst` global, the declarations name SST's types through
  // their modules (see src/global-aliases.d.ts). Without the global's module,
  // components/index, they name them through core and never through it:
  // TypeScript picks the shortest path to a type, and `../..` from a group's
  // file is that module, which loads every group and its providers.
  // scripts/build copies it in as its declaration.
  "exclude": [
    "templates",
    "functions",
    "src/global-aliases.d.ts",
    "src/components/index.ts"
  ]
}
