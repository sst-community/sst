{
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2022",
    "types": ["node"]
  }
}
