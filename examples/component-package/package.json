{
  "name": "@acme/webhook",
  "version": "0.1.0",
  "description": "An SST component: a URL that takes webhook deliveries and puts each on a queue",
  "keywords": [
    "sst-component",
    "sst",
    "aws"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./receiver": "./dist/receiver.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && npm run build && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1155.0"
  },
  "peerDependencies": {
    "sst": ">=5.0.0-0",
    "@pulumi/aws": "^7"
  },
  "peerDependenciesMeta": {
    "@pulumi/aws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pulumi/aws": "7.54.0",
    "@pulumi/command": "1.2.1",
    "@pulumi/docker-build": "0.0.22",
    "@pulumi/pulumi": "3.270.0",
    "@pulumi/random": "4.21.2",
    "@pulumi/tls": "5.6.1",
    "@types/node": "^22",
    "sst": "npm:@sst-community/sst@^5.0.0-0",
    "typescript": "^6",
    "vitest": "^5"
  }
}
